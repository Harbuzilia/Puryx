<UserControl x:Class="SmartCleaner.App.Views.CompactPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="900">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AccentGradientBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Сжатие CompactOS &amp; LZX" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="LZX ENGINE" FontSize="9.5" Foreground="White" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Прозрачное системное сжатие файлов Windows и игровых каталогов без падения производительности" 
                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource SecondaryButton}" 
                        Command="{Binding CancelCommand}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Отмена" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" 
                        Command="{Binding DiscoverCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Найти объекты для сжатия" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Summary Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Targets -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Объектов для оптимизации" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0">
                        <Run Text="{Binding TotalTargetsCount, Mode=OneWay}"/>
                        <Run Text="папок" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Card 2: Total Size -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="Текущий размер на диске" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0" Text="{Binding TotalSizeFormatted, Mode=OneWay}"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Estimated Savings -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="Потенциальная экономия (+30-50%)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SafeBrush}" Margin="0,4,0,0">
                        <Run Text="~"/>
                        <Run Text="{Binding EstimatedSavingsFormatted, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Target Folders List -->
        <ListBox Grid.Row="2" ItemsSource="{Binding Targets}" 
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Info -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <Border Background="{DynamicResource SurfaceVariantBrush}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                    <Border Background="{DynamicResource SurfaceVariantBrush}" CornerRadius="4" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding RecommendedAlgorithm}" FontSize="10" Foreground="{DynamicResource SafeBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{DynamicResource TextDisabledBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Size -->
                            <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding OriginalSizeFormatted}" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Right"/>
                                <TextBlock Text="Без потери FPS" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                            </StackPanel>

                            <!-- Action -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource SecondaryButton}" 
                                        Command="{Binding DataContext.DecompressTargetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding .}"
                                        Content="Распаковать" 
                                        Padding="8,5" Margin="0,0,6,0"
                                        Visibility="{Binding IsCompressed, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <Button Style="{StaticResource PrimaryButton}" 
                                        Command="{Binding DataContext.CompressTargetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding .}"
                                        Content="Сжать LZX" 
                                        Padding="10,5"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
