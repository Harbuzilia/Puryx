<UserControl x:Class="SmartCleaner.App.Views.DuplicatesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SmartCleaner.App.ViewModels"
             AllowDrop="True"
             Drop="OnDrop"
             DragOver="OnDragOver">

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AccentGradientBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Умный поиск дубликатов файлов" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="BYTE-EXACT" FontSize="9.5" Foreground="White" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Быстрое обнаружение одинаковых файлов по размеру, хэшу SHA-256 и побайтовому сравнению" 
                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- TabControl for 4 modes -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" 
                    Background="Transparent"
                    BorderThickness="0">

            <!-- ═══ Tab 1: Поиск дубликатов ═══ -->
            <TabItem Header="Дубликаты">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Options panel -->
                    <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" 
                            CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Folders + Exclude -->
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Папки для сканирования:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Width="32"
                                            Command="{Binding BrowseScanFoldersCommand}" 
                                            Style="{StaticResource SecondaryButton}" Margin="4,0,0,0" Padding="8,6">
                                        <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                    </Button>
                                    <TextBox Text="{Binding ScanFolders, UpdateSourceTrigger=PropertyChanged}" 
                                             MinHeight="50" AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"/>
                                </DockPanel>

                                <TextBlock Text="Исключения (по строкам):" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                <TextBox Text="{Binding ExcludePatterns, UpdateSourceTrigger=PropertyChanged}" 
                                         MinHeight="40" AcceptsReturn="True" TextWrapping="Wrap"
                                         FontSize="11" VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>

                            <!-- Right: Checkboxes -->
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Критерии сравнения:" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <CheckBox Content="По размеру" IsChecked="{Binding OptBySize}" Margin="0,2"/>
                                <CheckBox Content="По хэшу (SHA256)" IsChecked="{Binding OptByHash}" Margin="0,2"/>
                                <CheckBox Content="По имени файла" IsChecked="{Binding OptByName}" Margin="0,2"/>
                                <CheckBox Content="Побайтовое (точно, медленно)" IsChecked="{Binding OptByByte}" Margin="0,2"/>
                                <Separator Margin="0,6"/>
                                <CheckBox Content="Turbo — частичный хэш (быстро)" IsChecked="{Binding OptTurbo}" 
                                          Margin="0,2" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Мин. размер (байт):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox Text="{Binding MinFileSizeText, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Stats bar -->
                    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" 
                            CornerRadius="8" Padding="12,8" Margin="0,0,0,8"
                            Visibility="{Binding TotalGroups, Converter={StaticResource IntToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontWeight="SemiBold" Margin="0,0,16,0">
                                <Run Text="Групп: "/><Run Text="{Binding TotalGroups}" Foreground="{DynamicResource AccentBrush}"/>
                            </TextBlock>
                            <TextBlock Margin="0,0,16,0">
                                <Run Text="Дубликатов: "/><Run Text="{Binding TotalDuplicates}" Foreground="{DynamicResource CautionBrush}"/>
                            </TextBlock>
                            <TextBlock>
                                <Run Text="Потрачено впустую: "/><Run Text="{Binding TotalWasted}" Foreground="{DynamicResource DangerBrush}" FontWeight="Bold"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Results + Preview split -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Results list -->
                        <ListView Grid.Column="0" ItemsSource="{Binding DuplicateGroups}" 
                                  Background="Transparent" BorderThickness="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" 
                                            Padding="12" Margin="0,0,0,8">
                                        <StackPanel>
                                            <!-- Group header -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0"/>
                                                <TextBlock FontWeight="SemiBold">
                                                    <Run Text="{Binding FileCount, Mode=OneWay}"/><Run Text=" файлов × "/>
                                                    <Run Text="{Binding FileSize, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Foreground="{DynamicResource DangerBrush}" Margin="12,0,0,0">
                                                    <Run Text="−"/><Run Text="{Binding WastedFormatted, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <!-- Files in group -->
                                            <ItemsControl ItemsSource="{Binding Files}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Padding="4,3" Margin="12,1,0,1" CornerRadius="4" Cursor="Hand"
                                                                Background="Transparent"
                                                                MouseLeftButtonUp="OnFileClick">
                                                            <StackPanel Orientation="Horizontal">
                                                                <CheckBox IsChecked="{Binding IsSelected}" Margin="0,0,6,0"/>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                                                <TextBlock Text="{Binding SizeFormatted}" 
                                                                           Foreground="{DynamicResource TextSecondaryBrush}" 
                                                                           Margin="0,0,8,0" FontSize="11"/>
                                                                <TextBlock Text="{Binding Directory}" 
                                                                           Foreground="{DynamicResource TextSecondaryBrush}" 
                                                                           FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Preview panel -->
                        <Border Grid.Column="1" Width="280" Background="{DynamicResource SurfaceBrush}" 
                                CornerRadius="8" Padding="12" Margin="8,0,0,0"
                                Visibility="{Binding SelectedPreviewFile, Converter={StaticResource NullToVisibilityConverter}}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Превью" FontWeight="SemiBold" Margin="0,0,0,8"/>

                                    <!-- Image preview -->
                                    <Image Source="{Binding PreviewImage}" MaxHeight="220" Stretch="Uniform"
                                           Margin="0,0,0,8">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PreviewMode}" Value="image">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>

                                    <!-- Text preview -->
                                    <TextBox Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True"
                                             TextWrapping="Wrap" MaxHeight="300" FontSize="10"
                                             FontFamily="Cascadia Code,Consolas,Courier New"
                                             VerticalScrollBarVisibility="Auto"
                                             BorderThickness="0" Background="Transparent">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PreviewMode}" Value="text">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>

                                    <!-- Info preview -->
                                    <TextBlock Text="{Binding PreviewInfo}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PreviewMode}" Value="info">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ═══ Tab 2: Поиск по образцу ═══ -->
            <TabItem Header="По образцу">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" 
                            CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Файл-образец:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Width="32"
                                        Command="{Binding BrowseSampleFileCommand}" 
                                        Style="{StaticResource SecondaryButton}" Margin="4,0,0,0">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                </Button>
                                <TextBox Text="{Binding SampleFilePath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>
                            </DockPanel>

                            <TextBlock Text="Искать в папках:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Width="32"
                                        Command="{Binding BrowseSampleSearchFoldersCommand}" 
                                        Style="{StaticResource SecondaryButton}" Margin="4,0,0,0">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                </Button>
                                <TextBox Text="{Binding SampleSearchFolders, UpdateSourceTrigger=PropertyChanged}" 
                                         MinHeight="50" AcceptsReturn="True" TextWrapping="Wrap"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Sample results -->
                    <ListView Grid.Row="1" ItemsSource="{Binding SampleResults}" 
                              Background="Transparent" BorderThickness="0">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6" 
                                        Padding="10" Margin="0,0,0,4">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Directory}" 
                                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding SizeFormatted}" Margin="0,0,12,0"/>
                                            <TextBlock Text="{Binding Modified, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" 
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabItem>

            <!-- ═══ Tab 3: Сравнение папок ═══ -->
            <TabItem Header="Сравнение">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" 
                            CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Папка A:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Width="32"
                                            Command="{Binding BrowseFolderACommand}" 
                                            Style="{StaticResource SecondaryButton}" Margin="4,0,0,0">
                                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                    </Button>
                                    <TextBox Text="{Binding CompareFolderA, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Папка B:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Width="32"
                                            Command="{Binding BrowseFolderBCommand}" 
                                            Style="{StaticResource SecondaryButton}" Margin="4,0,0,0">
                                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                    </Button>
                                    <TextBox Text="{Binding CompareFolderB, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Stats -->
                    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" 
                            CornerRadius="8" Padding="12,8" Margin="0,0,0,8"
                            Visibility="{Binding CommonCount, Converter={StaticResource IntToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,16,0">
                                <Run Text="Только A: "/><Run Text="{Binding UniqueACount}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                            </TextBlock>
                            <TextBlock Margin="0,0,16,0">
                                <Run Text="Только B: "/><Run Text="{Binding UniqueBCount}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                            </TextBlock>
                            <TextBlock>
                                <Run Text="Общие: "/><Run Text="{Binding CommonCount}" Foreground="{DynamicResource SafeBrush}" FontWeight="SemiBold"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Compare results table -->
                    <DataGrid Grid.Row="2" ItemsSource="{Binding CompareResults}" 
                              AutoGenerateColumns="False" IsReadOnly="True"
                              Background="Transparent" BorderThickness="0"
                              RowBackground="{DynamicResource SurfaceBrush}"
                              AlternatingRowBackground="{DynamicResource BackgroundBrush}"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource BorderBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="140"/>
                            <DataGridTextColumn Header="Путь" Binding="{Binding Path}" Width="*"/>
                            <DataGridTextColumn Header="Размер A" Binding="{Binding SizeA}" Width="90"/>
                            <DataGridTextColumn Header="Размер B" Binding="{Binding SizeB}" Width="90"/>
                            <DataGridTextColumn Header="Новее" Binding="{Binding Newer}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ═══ Tab 4: Лог удалений ═══ -->
            <TabItem Header="Лог удалений">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Action buttons -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="Открыть корзину" 
                                Command="{Binding OpenRecycleBinCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                        <Button Content="Очистить лог" 
                                Command="{Binding ClearDeletionHistoryCommand}"
                                Style="{StaticResource SecondaryButton}"/>
                    </StackPanel>

                    <!-- Deletion sessions list -->
                    <ListView Grid.Row="1" ItemsSource="{Binding DeletionHistory}" 
                              Background="Transparent" BorderThickness="0">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" 
                                        Padding="12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding TimestampFormatted}" FontWeight="SemiBold" Margin="0,0,12,0"/>
                                            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}">
                                                <Run Text="{Binding FileCount, Mode=OneWay}"/><Run Text=" файлов • "/>
                                                <Run Text="{Binding TotalSize, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding Files}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontSize="11" 
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis" Margin="16,1,0,1"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Bottom action bar with progress -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" 
                CornerRadius="8" Padding="16,12" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Progress bar (visible only during scanning) -->
                <ProgressBar Grid.Row="0" Height="4" Margin="0,0,0,8"
                             Value="{Binding ProgressPercent}" Minimum="0" Maximum="100"
                             IsIndeterminate="{Binding IsProgressIndeterminate}"
                             Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}"
                             Foreground="{DynamicResource AccentBrush}"/>

                <!-- Status + buttons -->
                <DockPanel Grid.Row="1">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Заменить хардлинками" 
                                Command="{Binding ReplaceWithHardlinksCommand}"
                                Style="{StaticResource PrimaryButton}"
                                ToolTip="Заменяет дубликаты жесткими ссылками NTFS: освобождает место без удаления путей"
                                Visibility="{Binding TotalGroups, Converter={StaticResource IntToVisibilityConverter}}"
                                Margin="0,0,8,0"/>
                        <Button Content="Удалить выбранные" 
                                Command="{Binding DeleteSelectedDuplicatesCommand}"
                                Style="{StaticResource DangerButton}"
                                Visibility="{Binding TotalGroups, Converter={StaticResource IntToVisibilityConverter}}"
                                Margin="0,0,8,0"/>
                        <Button Content="Отмена" 
                                Command="{Binding CancelScanCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}"
                                Margin="0,0,8,0"/>
                        <Button Content="Сканировать" 
                                Command="{Binding StartDuplicateScanCommand}"
                                IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolConverter}}"
                                Style="{StaticResource PrimaryButton}">
                            <Button.Visibility>
                                <Binding Path="SelectedTabIndex" Converter="{StaticResource IntToVisibilityConverter}" ConverterParameter="0"/>
                            </Button.Visibility>
                        </Button>
                        <Button Content="Найти копии" 
                                Command="{Binding StartSampleScanCommand}"
                                IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolConverter}}"
                                Style="{StaticResource PrimaryButton}">
                            <Button.Visibility>
                                <Binding Path="SelectedTabIndex" Converter="{StaticResource IntToVisibilityConverter}" ConverterParameter="1"/>
                            </Button.Visibility>
                        </Button>
                        <Button Content="Сравнить" 
                                Command="{Binding StartCompareFoldersCommand}"
                                IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolConverter}}"
                                Style="{StaticResource PrimaryButton}">
                            <Button.Visibility>
                                <Binding Path="SelectedTabIndex" Converter="{StaticResource IntToVisibilityConverter}" ConverterParameter="2"/>
                            </Button.Visibility>
                        </Button>
                    </StackPanel>

                    <!-- Status text + percentage -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusText}" 
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Margin="8,0,0,0" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Run Text="{Binding ProgressPercent, Mode=OneWay}"/><Run Text="%"/>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
