<UserControl x:Class="SmartCleaner.App.Views.StartupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SmartCleaner.App.ViewModels">

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AccentGradientBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Управление автозагрузкой" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="BOOT SPEED" FontSize="9.5" Foreground="White" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Контроль программ, служб и задач, запускающихся вместе с операционной системой Windows" 
                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" 
                CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                            Style="{StaticResource PrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Обновить" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Stats -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Margin="0,0,16,0">
                        <Run Text="Всего: "/><Run Text="{Binding TotalCount}" FontWeight="SemiBold"/>
                    </TextBlock>
                    <TextBlock Margin="0,0,16,0">
                        <Run Text="Активных: "/><Run Text="{Binding EnabledCount}" Foreground="{DynamicResource SafeBrush}" FontWeight="SemiBold"/>
                    </TextBlock>

                    <!-- Filter -->
                    <TextBlock Text="Фильтр:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox SelectedIndex="{Binding FilterIndex}" Width="130">
                        <ComboBoxItem Content="Все"/>
                        <ComboBoxItem Content="Включённые"/>
                        <ComboBoxItem Content="Отключённые"/>
                    </ComboBox>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Items list -->
        <ListView Grid.Row="2" ItemsSource="{Binding Items}" 
                  SelectedItem="{Binding SelectedItem}"
                  Background="Transparent" BorderThickness="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" 
                            Padding="14,10" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Status icon -->
                            <TextBlock Grid.Column="0" Text="{Binding StatusIcon}" FontSize="18" 
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>

                            <!-- Info -->
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="{Binding Command}" FontSize="11" 
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <Border Background="{DynamicResource SurfaceVariantBrush}" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding SourceDescription}" FontSize="10"/>
                                    </Border>
                                    <TextBlock Text="{Binding Publisher}" FontSize="10"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Actions -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="{Binding IsEnabled, Converter={StaticResource BoolToToggleTextConverter}}"
                                        Command="{Binding DataContext.ToggleItemCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,4,0" Padding="10,6" FontSize="11"/>
                                <Button Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource DangerButton}"
                                        Padding="8,6">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Status bar -->
        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" 
                CornerRadius="8" Padding="16,10" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusText}" 
                       Foreground="{DynamicResource TextSecondaryBrush}" 
                       TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</UserControl>
