<UserControl x:Class="SmartCleaner.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:SmartCleaner.Core.Localization;assembly=SmartCleaner.Core"
             mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="24,20" Padding="0,0,8,0">
        <StackPanel>
            
            <!-- Header -->
            <DockPanel Margin="0,0,0,24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AccentGradientBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{x:Static loc:Localizer.Settings_Title}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="PREFERENCES" FontSize="9.5" Foreground="White" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{x:Static loc:Localizer.Settings_Subtitle}" 
                               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>

            <!-- Appearance / Theme -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{x:Static loc:Localizer.Settings_SectionAppearance}" 
                               Style="{StaticResource Heading2}"
                               Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static loc:Localizer.Settings_ThemeLabel}" 
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0"/>
                        <ComboBox Grid.Column="1"
                                  Width="180"
                                  HorizontalAlignment="Left"
                                  ItemsSource="{Binding ThemeOptions}"
                                  SelectedIndex="{Binding SelectedThemeIndex}"/>
                    </Grid>

                    <!-- Язык интерфейса (ROADMAP v3.1, фаза L): применяется при следующем старте -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static loc:Localizer.Settings_Language}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0"/>
                        <StackPanel Grid.Column="1">
                            <ComboBox Width="180"
                                      HorizontalAlignment="Left"
                                      ItemsSource="{Binding LanguageOptions}"
                                      SelectedIndex="{Binding SelectedLanguageIndex}"/>
                            <TextBlock Text="{x:Static loc:Localizer.Settings_LanguageDescription}"
                                       Style="{StaticResource Caption}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Mode Info -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{x:Static loc:Localizer.Settings_SectionMode}" 
                               Style="{StaticResource Heading2}"
                               Margin="0,0,0,12"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="{x:Static loc:Localizer.Settings_ConfigModeLabel}" 
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,16,8"/>
                        <TextBlock Grid.Column="1" 
                                   Text="{Binding ConfigModeText}"
                                   FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="1" 
                                   Text="{x:Static loc:Localizer.Common_Path}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,16,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" 
                                   Text="{Binding ConfigPath}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding ConfigPath}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Cleaning Settings -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{x:Static loc:Localizer.Settings_SectionCleaning}" 
                               Style="{StaticResource Heading2}"
                               Margin="0,0,0,12"/>

                    <CheckBox Content="{x:Static loc:Localizer.Settings_UseRecycleBin}"
                              IsChecked="{Binding UseRecycleBin}"
                              Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{x:Static loc:Localizer.Settings_ProtectedPeriodLabel}" 
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <TextBox Text="{Binding ProtectedHours, UpdateSourceTrigger=PropertyChanged}"
                                 Width="60"
                                 VerticalAlignment="Center"
                                 Padding="8,4"
                                 Background="{DynamicResource SurfaceVariantBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"/>
                        <TextBlock Text="{x:Static loc:Localizer.Settings_HoursUnit}" 
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    
                    <TextBlock Text="{x:Static loc:Localizer.Settings_ProtectedPeriodHint}"
                               Style="{StaticResource Caption}"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Scanning: MFT mode (ROADMAP v3.1, День 9) -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{x:Static loc:Localizer.Settings_SectionScanning}" 
                               Style="{StaticResource Heading2}"
                               Margin="0,0,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{x:Static loc:Localizer.Settings_MftModeLabel}" 
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0"/>
                        <StackPanel Grid.Column="1">
                            <ComboBox Width="180"
                                      HorizontalAlignment="Left"
                                      ItemsSource="{Binding MftModeOptions}"
                                      SelectedIndex="{Binding SelectedMftModeIndex}"/>
                            <TextBlock Text="{x:Static loc:Localizer.Settings_MftModeHint}"
                                       Style="{StaticResource Caption}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Custom Scan Paths -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{x:Static loc:Localizer.Settings_SectionScanPaths}" 
                               Style="{StaticResource Heading2}"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="{x:Static loc:Localizer.Settings_ScanPathsHint}"
                               Style="{StaticResource Caption}"
                               Margin="0,0,0,16"/>

                    <!-- Add Path -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Text="{Binding NewScanPath, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="12,8"
                                 Background="{DynamicResource SurfaceVariantBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 VerticalAlignment="Center">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AddScanPathCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        
                        <Button Grid.Column="1" 
                                ToolTip="{x:Static loc:Localizer.Settings_BrowseFolderToolTip}"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding BrowseFolderCommand}"
                                Margin="8,0,0,0">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                        </Button>
                        
                        <Button Grid.Column="2" 
                                Content="{x:Static loc:Localizer.Settings_Add}"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding AddScanPathCommand}"
                                Margin="8,0,0,0"/>
                    </Grid>

                    <!-- Paths List -->
                    <ItemsControl ItemsSource="{Binding CustomScanPaths}" 
                                  MaxHeight="200">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceVariantBrush}"
                                        CornerRadius="4"
                                        Padding="12,8"
                                        Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding}"
                                                   FontFamily="Consolas"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding}"/>

                                        <Button Grid.Column="1"
                                                Content="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                                Background="Transparent"
                                                Foreground="{DynamicResource DangerBrush}"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Padding="8,4"
                                                Command="{Binding DataContext.RemoveScanPathCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Whitelist -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{x:Static loc:Localizer.Settings_SectionWhitelist}" 
                               Style="{StaticResource Heading2}"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="{x:Static loc:Localizer.Settings_WhitelistHint}"
                               Style="{StaticResource Caption}"
                               Margin="0,0,0,16"/>

                    <!-- Add Pattern -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Text="{Binding NewWhitelistPattern, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="12,8"
                                 Background="{DynamicResource SurfaceVariantBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 VerticalAlignment="Center">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AddPatternCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        
                        <Button Grid.Column="1" 
                                Content="{x:Static loc:Localizer.Settings_Add}"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding AddPatternCommand}"
                                Margin="8,0,0,0"/>
                    </Grid>

                    <!-- Pattern Examples -->
                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,12">
                        <Run Text="{x:Static loc:Localizer.Settings_ExamplesLabel}"/>
                        <Run Text="**\SaveGames\**" FontFamily="Consolas" Foreground="{DynamicResource AccentBrush}"/>
                        <Run Text="—"/>
                        <Run Text="%USERPROFILE%\.myconfig" FontFamily="Consolas" Foreground="{DynamicResource AccentBrush}"/>
                    </TextBlock>

                    <!-- Patterns List -->
                    <ItemsControl ItemsSource="{Binding WhitelistPatterns}" 
                                  MaxHeight="300">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceVariantBrush}"
                                        CornerRadius="4"
                                        Padding="12,8"
                                        Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding}"
                                                   FontFamily="Consolas"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding}"/>

                                        <Button Grid.Column="1"
                                                Content="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                                Background="Transparent"
                                                Foreground="{DynamicResource DangerBrush}"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Padding="8,4"
                                                Command="{Binding DataContext.RemovePatternCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Built-in notice -->
                    <Border Background="{DynamicResource SurfaceVariantBrush}"
                            CornerRadius="4"
                            Padding="12,8"
                            Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Static loc:Localizer.Settings_BuiltInPatternsNote}"
                                       Style="{StaticResource Caption}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Sound & Audio Feedback -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{x:Static loc:Localizer.Settings_SectionSound}" 
                               Style="{StaticResource Heading2}"
                               Margin="0,0,0,12"/>
                    <CheckBox Content="{x:Static loc:Localizer.Settings_SoundCheckbox}"
                              IsChecked="{Binding IsSoundEnabled, Mode=TwoWay}"
                              Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                </StackPanel>
            </Border>

            <!-- Executive System Passport & HTML Report -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{x:Static loc:Localizer.Settings_SectionReport}" 
                               Style="{StaticResource Heading2}"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="{x:Static loc:Localizer.Settings_ReportDescription}"
                               Style="{StaticResource BodyText}" Margin="0,0,0,14"/>

                    <Button Content="{x:Static loc:Localizer.Settings_GenerateReport}" 
                            Command="{Binding GenerateSystemReportCommand}"
                            Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Padding="18,10" FontSize="13" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <!-- Windows Explorer Shell Integration -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{x:Static loc:Localizer.Settings_SectionShellIntegration}" 
                               Style="{StaticResource Heading2}"
                               Margin="0,0,0,12"/>
                    <TextBlock Text="{x:Static loc:Localizer.Settings_ShellIntegrationHint}"
                               Style="{StaticResource BodyText}" Margin="0,0,0,14"/>

                    <StackPanel>
                        <CheckBox Content="{x:Static loc:Localizer.Settings_ShellAnalyzeMenu}"
                                  IsChecked="{Binding IsAnalyzeMenuEnabled, Mode=TwoWay}"
                                  Command="{Binding ToggleAnalyzeMenuCommand}"
                                  Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" Margin="0,0,0,8"/>

                        <CheckBox Content="{x:Static loc:Localizer.Settings_ShellCompactMenu}"
                                  IsChecked="{Binding IsCompactMenuEnabled, Mode=TwoWay}"
                                  Command="{Binding ToggleCompactMenuCommand}"
                                  Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" Margin="0,0,0,8"/>

                        <CheckBox Content="{x:Static loc:Localizer.Settings_ShellShredMenu}"
                                  IsChecked="{Binding IsShredMenuEnabled, Mode=TwoWay}"
                                  Command="{Binding ToggleShredMenuCommand}"
                                  Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
