<UserControl x:Class="SmartCleaner.App.Views.CliInspectorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:SmartCleaner.Core.Localization;assembly=SmartCleaner.Core"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="900">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AccentGradientBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{x:Static loc:Localizer.CliInspector_Title}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="DEV &amp; CLI" FontSize="9.5" Foreground="White" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="{x:Static loc:Localizer.CliInspector_Subtitle}" 
                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource SecondaryButton}" 
                        Command="{Binding ExportReportCommand}"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72D;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Static loc:Localizer.CliInspector_ExportReport}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" 
                        Command="{Binding ScanCommand}"
                        IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Static loc:Localizer.Common_Scan}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Summary Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Tools & Size -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="{x:Static loc:Localizer.CliInspector_StatTools}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0">
                        <Run Text="{Binding TotalToolsCount, Mode=OneWay}"/>
                        <Run Text="{x:Static loc:Localizer.CliInspector_PiecesUnit}" FontSize="14" FontWeight="Normal"/>
                        <Run Text="{Binding TotalSizeFormatted, Mode=OneWay}" FontSize="14" FontWeight="Normal"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Card 2: Dead PATH entries -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="{x:Static loc:Localizer.CliInspector_StatDeadPaths}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock FontSize="20" FontWeight="Bold" Margin="0,4,0,0"
                               Foreground="{Binding DeadPathsCount, Converter={StaticResource ZeroToColorConverter}}">
                        <Run Text="{Binding DeadPathsCount, Mode=OneWay}"/>
                        <Run Text="{x:Static loc:Localizer.CliInspector_PathCountSeparator}" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <Run Text="{Binding TotalPathsCount, Mode=OneWay}" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Card 3: PowerShell profiles -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="{x:Static loc:Localizer.CliInspector_StatPsProfiles}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SafeBrush}" Margin="0,4,0,0">
                        <Run Text="{Binding PsProfilesCount, Mode=OneWay}"/>
                        <Run Text="{x:Static loc:Localizer.CliInspector_FoundUnit}" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main Tab Control -->
        <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTabIndex}">
            
            <!-- ════════ TAB 1: CLI & AI TOOLS ════════ -->
            <TabItem Header="{x:Static loc:Localizer.CliInspector_TabTools}">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Filter Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                 Padding="8,6" VerticalAlignment="Center"
                                 Tag="{x:Static loc:Localizer.CliInspector_SearchPlaceholder}"/>
                        
                        <TextBlock Grid.Column="1" Text="{x:Static loc:Localizer.Common_CategoryLabel}" VerticalAlignment="Center" 
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="16,0,8,0"/>

                        <ComboBox Grid.Column="2" 
                                  ItemsSource="{Binding Categories}" 
                                  SelectedItem="{Binding SelectedCategory}"
                                  VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Tools List -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding FilteredTools}" 
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Info -->
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <Border Background="{DynamicResource SurfaceVariantBrush}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{DynamicResource AccentBrush}"/>
                                                </Border>
                                                <Border Background="{DynamicResource SurfaceVariantBrush}" CornerRadius="4" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center"
                                                        Visibility="{Binding Version, Converter={StaticResource EmptyStringToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding Version, StringFormat='v{0}'}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,2" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{DynamicResource TextDisabledBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- Size & Date -->
                                        <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding SizeFormatted}" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding LastModified}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" HorizontalAlignment="Right"/>
                                        </StackPanel>

                                        <!-- Actions -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource SubtleButton}" 
                                                    Command="{Binding DataContext.OpenInExplorerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Path}"
                                                    ToolTip="{x:Static loc:Localizer.CliInspector_ToolTipOpenInExplorer}" Margin="2,0">
                                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                            </Button>

                                            <Button Style="{StaticResource SubtleButton}" 
                                                    Command="{Binding DataContext.OpenTerminalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Path}"
                                                    ToolTip="{x:Static loc:Localizer.CliInspector_ToolTipOpenTerminal}" Margin="2,0">
                                                <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                            </Button>

                                            <Button Style="{StaticResource SubtleButton}" 
                                                    Command="{Binding DataContext.CopyUninstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding UninstallCmd}"
                                                    ToolTip="{x:Static loc:Localizer.CliInspector_ToolTipCopyUninstall}" Margin="2,0">
                                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                            </Button>

                                            <Button Style="{StaticResource SubtleButton}" 
                                                    Command="{Binding DataContext.DeleteToolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding .}"
                                                    ToolTip="{x:Static loc:Localizer.CliInspector_ToolTipDeleteToRecycleBin}" Margin="2,0">
                                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource DangerBrush}"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <!-- ════════ TAB 2: PATH HEALTH & DEAD PATHS ════════ -->
            <TabItem Header="{x:Static loc:Localizer.CliInspector_TabPathHealth}">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Info & Action Bar -->
                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14,10" Background="{DynamicResource SurfaceVariantBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{x:Static loc:Localizer.CliInspector_PathAnalyzerTitle}" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="{x:Static loc:Localizer.CliInspector_PathAnalyzerDescription}" 
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" 
                                    Content="{x:Static loc:Localizer.CliInspector_CleanDeadPaths}" 
                                    Style="{StaticResource DangerButton}" 
                                    Command="{Binding CleanDeadPathsCommand}"
                                    VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Path List -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding PathEntries}" 
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,6" Padding="12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Status Badge -->
                                        <Border Grid.Column="0" CornerRadius="4" Padding="6,2" Margin="0,0,12,0" VerticalAlignment="Center"
                                                Background="{DynamicResource SurfaceVariantBrush}">
                                            <TextBlock Text="{Binding Scope}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>

                                        <!-- Path and Status -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Path}" FontWeight="Medium" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontSize="11" Margin="0,2,0,0">
                                                <Run Text="{Binding Status}" FontWeight="SemiBold"
                                                     Foreground="{Binding IsDead, Converter={StaticResource DeadStatusColorConverter}}"/>
                                                <Run Text="{x:Static loc:Localizer.CliInspector_BinCountLabel}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <Run Text="{Binding BinCount}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Size -->
                                        <TextBlock Grid.Column="2" Text="{Binding SizeFormatted}" FontSize="12" 
                                                   VerticalAlignment="Center" Margin="12,0" Foreground="{DynamicResource TextSecondaryBrush}"/>

                                        <!-- Actions -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource SubtleButton}" 
                                                    Command="{Binding DataContext.OpenInExplorerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Path}"
                                                    ToolTip="{x:Static loc:Localizer.CliInspector_ToolTipOpenInExplorer}"
                                                    Visibility="{Binding Exists, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                            </Button>

                                            <Button Style="{StaticResource SubtleButton}" 
                                                    Command="{Binding DataContext.RemoveSinglePathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding .}"
                                                    ToolTip="{x:Static loc:Localizer.CliInspector_ToolTipRemovePathEntry}">
                                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource DangerBrush}"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <!-- ════════ TAB 3: POWERSHELL PROFILES ════════ -->
            <TabItem Header="PowerShell Profiles ($PROFILE)">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14,10" Background="{DynamicResource SurfaceVariantBrush}">
                        <StackPanel>
                            <TextBlock Text="{x:Static loc:Localizer.CliInspector_PsProfilesTitle}" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="{x:Static loc:Localizer.CliInspector_PsProfilesDescription}" 
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <ListBox Grid.Row="1" ItemsSource="{Binding PsProfiles}" 
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14,12">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>
                                                <Border Background="{DynamicResource SurfaceVariantBrush}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding SizeFormatted}" FontSize="10" Foreground="{DynamicResource AccentBrush}"/>
                                                </Border>
                                            </StackPanel>

                                            <Button Grid.Column="1" Style="{StaticResource SubtleButton}" 
                                                    Command="{Binding DataContext.OpenInExplorerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Path}"
                                                    ToolTip="{x:Static loc:Localizer.CliInspector_ToolTipOpenFile}">
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,4,0"/><TextBlock Text="{x:Static loc:Localizer.CliInspector_Open}" FontSize="12"/></StackPanel>
                                            </Button>
                                        </Grid>

                                        <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{DynamicResource TextDisabledBrush}" Margin="0,4,0,8"/>

                                        <!-- Script Preview Box -->
                                        <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="6" Padding="10" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                                            <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                                                <TextBlock Text="{Binding Content}" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="11" 
                                                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                            </ScrollViewer>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>

