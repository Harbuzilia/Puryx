<UserControl x:Class="SmartCleaner.App.Views.SchedulerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="24,20" MaxWidth="600" HorizontalAlignment="Left">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AccentGradientBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="&#xEC92;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Автоматический планировщик" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="AUTO CRON" FontSize="9.5" Foreground="White" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Настройка регулярного обслуживания дисков в фоновом режиме по расписанию" 
                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- Settings Card -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="20" Margin="0,0,0,16">
            <StackPanel>
                <!-- Enable toggle -->
                <DockPanel Margin="0,0,0,16">
                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsEnabled}" 
                              Content="Включить автоматическую очистку" 
                              FontSize="14" FontWeight="SemiBold"/>
                </DockPanel>

                <Separator Margin="0,0,0,16"/>

                <!-- Interval -->
                <TextBlock Text="РАСПИСАНИЕ" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextDisabledBrush}" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Интервал:" VerticalAlignment="Center" Width="90"/>
                    <ComboBox ItemsSource="{Binding Intervals}" 
                              SelectedIndex="{Binding SelectedIntervalIndex}" Width="160"/>
                </StackPanel>

                <!-- Day of week (visible only for Weekly) -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12"
                            Visibility="{Binding SelectedIntervalIndex, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=1}">
                    <TextBlock Text="День недели:" VerticalAlignment="Center" Width="90"/>
                    <ComboBox ItemsSource="{Binding DaysOfWeek}" 
                              SelectedIndex="{Binding SelectedDayOfWeek}" Width="160"/>
                </StackPanel>

                <!-- Time -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Время:" VerticalAlignment="Center" Width="90"/>
                    <TextBox Text="{Binding Hour}" Width="40" Margin="0,0,4,0"/>
                    <TextBlock Text=":" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Text="{Binding Minute}" Width="40"/>
                </StackPanel>

                <Separator Margin="0,4,0,12"/>

                <!-- Profile -->
                <TextBlock Text="ПРОФИЛЬ" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextDisabledBrush}" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBlock Text="Профиль:" VerticalAlignment="Center" Width="90"/>
                    <ComboBox ItemsSource="{Binding Profiles}" 
                              SelectedIndex="{Binding SelectedProfileIndex}" Width="160"/>
                </StackPanel>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Удалить задачу" 
                            Command="{Binding RemoveTaskCommand}"
                            Style="{StaticResource DangerButton}" Margin="0,0,8,0" Padding="14,8"/>
                    <Button Content="Сохранить" 
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource PrimaryButton}" Padding="20,8"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Info Card -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="20">
            <StackPanel>
                <TextBlock Text="ℹ️ ИНФОРМАЦИЯ" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextDisabledBrush}" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Статус задачи:" Width="120"/>
                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Последний запуск:" Width="120"/>
                    <TextBlock Text="{Binding LastRunText}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
