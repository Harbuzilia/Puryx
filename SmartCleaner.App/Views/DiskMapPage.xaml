<UserControl x:Class="SmartCleaner.App.Views.DiskMapPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SmartCleaner.App.Controls">

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AccentGradientBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="&#xE81E;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Интерактивная карта диска" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="TREEMAP" FontSize="9.5" Foreground="White" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Наглядная древовидная визуализация занятого дискового пространства с быстрым переходом" 
                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" 
                CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
            <DockPanel>
                <!-- Right: buttons -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Command="{Binding CancelScanCommand}"
                            Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Отмена" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ScanCommand}"
                            IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolConverter}}"
                            Style="{StaticResource PrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Анализировать" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Left: path + depth -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Путь:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding ScanPath, UpdateSourceTrigger=PropertyChanged}" Width="300" Margin="0,0,4,0"/>
                    <Button Command="{Binding BrowseFolderCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,12,0" Padding="8,6">
                        <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                    </Button>

                    <TextBlock Text="Глубина:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding MaxDepth, UpdateSourceTrigger=PropertyChanged}" Width="40"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- TreeMap + Info split -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- TreeMap visualization -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" 
                    CornerRadius="8" ClipToBounds="True">
                <controls:TreeMapControl 
                    RootNode="{Binding RootNode}"
                    SelectedNode="{Binding SelectedNode, Mode=TwoWay}"/>
            </Border>

            <!-- Info panel -->
            <Border Grid.Column="1" Width="240" Background="{DynamicResource SurfaceBrush}" 
                    CornerRadius="8" Padding="12" Margin="8,0,0,0"
                    Visibility="{Binding SelectedNode, Converter={StaticResource NullToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Информация" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding SelectedNodeInfo}" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Separator Margin="0,12"/>
                    <Button Content="Открыть в проводнике" 
                            Command="{Binding OpenInExplorerCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="0,4,0,0"
                            HorizontalAlignment="Stretch"/>
                    <Button Content="Вернуться к корню"
                            Command="{Binding GoToRootCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="0,4,0,0"
                            HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" 
                CornerRadius="8" Padding="16,10" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <ProgressBar Width="100" Height="4" Margin="0,0,12,0"
                             IsIndeterminate="True"
                             Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}"
                             Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock Text="{Binding StatusText}" 
                           Foreground="{DynamicResource TextSecondaryBrush}" 
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
