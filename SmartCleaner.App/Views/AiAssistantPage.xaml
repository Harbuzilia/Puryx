<UserControl x:Class="SmartCleaner.App.Views.AiAssistantPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="900">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AccentGradientBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="&#xE99A;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Умный AI-Ассистент очистки" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="AI CO-PILOT" FontSize="9.5" Foreground="White" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Диалог с диском: сформулируйте задачу на естественном языке, а AI выполнит аудит и предложит решение" 
                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- Chat History -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,12">
                                <!-- User Bubble -->
                                <Border Background="{DynamicResource AccentBrush}" CornerRadius="12,12,2,12" 
                                        Padding="14,10" HorizontalAlignment="Right" MaxWidth="600"
                                        Visibility="{Binding IsUser, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding Text}" Foreground="White" FontSize="13" TextWrapping="Wrap"/>
                                </Border>

                                <!-- AI Assistant Bubble -->
                                <Border Background="{DynamicResource SurfaceVariantBrush}" CornerRadius="12,12,12,2" 
                                        Padding="14,10" HorizontalAlignment="Left" MaxWidth="680"
                                        Visibility="{Binding IsUser, Converter={StaticResource InverseBoolConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Text}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        
                                        <!-- Action Button inside Assistant Reply -->
                                        <Button Margin="0,10,0,0" Padding="12,6" HorizontalAlignment="Left"
                                                Style="{StaticResource PrimaryButton}"
                                                Content="{Binding ActionButtonText}"
                                                Command="{Binding DataContext.ExecuteActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding .}"
                                                Visibility="{Binding ActionButtonText, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Input Box & Send Button -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="InputTextBox" Grid.Column="0" 
                     Text="{Binding UserInput, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="InputTextBox_KeyDown"
                     Padding="12,10" FontSize="13"
                     Tag="Напишите запрос (например: «Найди видео больше 1 ГБ» или «Освободи 20 ГБ под игры»)..."/>

            <Button Grid.Column="1" Margin="8,0,0,0" Padding="16,10"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding SendMessageCommand}"
                    Content="Отправить"/>
        </Grid>
    </Grid>
</UserControl>
