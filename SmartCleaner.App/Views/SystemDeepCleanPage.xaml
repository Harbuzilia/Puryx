<UserControl x:Class="SmartCleaner.App.Views.SystemDeepCleanPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:SmartCleaner.Core.Localization;assembly=SmartCleaner.Core"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="900">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AccentGradientBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="&#xE7EF;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{x:Static loc:Localizer.SystemDeepClean_Title}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="DISM &amp; DRIVERS" FontSize="9.5" Foreground="White" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="{x:Static loc:Localizer.SystemDeepClean_Subtitle}" 
                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" 
                    Style="{StaticResource PrimaryButton}" 
                    Command="{Binding RunAuditCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{x:Static loc:Localizer.SystemDeepClean_RunAudit}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Section 1: WinSxS Card -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static loc:Localizer.SystemDeepClean_WinSxSTitle}" FontWeight="Bold" FontSize="15"/>
                        <Border Background="{DynamicResource SafeBrush}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0"
                                Visibility="{Binding WinSxSCleanupRecommended, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{x:Static loc:Localizer.SystemDeepClean_CleanupRecommended}" FontSize="10" Foreground="White" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{x:Static loc:Localizer.SystemDeepClean_WinSxSDescription}" 
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static loc:Localizer.SystemDeepClean_ActualSizeLabel}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding WinSxSActualSize}" FontWeight="SemiBold" FontSize="12" Margin="0,0,16,0"/>
                        <TextBlock Text="{x:Static loc:Localizer.SystemDeepClean_ReclaimableLabel}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding WinSxSReclaimable}" FontWeight="Bold" Foreground="{DynamicResource SafeBrush}" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" 
                        Style="{StaticResource PrimaryButton}" 
                        Command="{Binding CleanWinSxSCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Static loc:Localizer.SystemDeepClean_CleanWinSxS}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Section 2: DriverStore Duplicate Drivers -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{x:Static loc:Localizer.SystemDeepClean_DriversTitle}" FontWeight="Bold" FontSize="14"/>
                    <TextBlock Text="{x:Static loc:Localizer.SystemDeepClean_DriversDescription}" 
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Style="{StaticResource DangerButton}" 
                        Command="{Binding CleanSelectedDriversCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                        HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Static loc:Localizer.SystemDeepClean_DeleteSelectedDrivers}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </DockPanel>

            <ListBox Grid.Row="1" ItemsSource="{Binding OldDrivers}" 
                     Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,6" Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding PublishedName}" FontWeight="SemiBold" FontSize="13"/>
                                        <Border Background="{DynamicResource SurfaceVariantBrush}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding ClassName}" FontSize="10" Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0">
                                        <Run Text="{Binding ProviderName}"/>
                                        <Run Text="•"/>
                                        <Run Text="{Binding OriginalName}"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding DriverVersion}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    <Border Background="{DynamicResource CautionBrush}" Opacity="0.9" CornerRadius="4" Padding="6,2" Margin="0,2,0,0">
                                        <TextBlock Text="{x:Static loc:Localizer.SystemDeepClean_StaleDuplicateBadge}" FontSize="9" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
