<UserControl x:Class="SmartCleaner.App.Views.DiscoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AccentGradientBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Автообнаружение приложений" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="AUTO DISCOVERY" FontSize="9.5" Foreground="White" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Эвристический поиск неизвестных программ и каталогов с накапливающимся кэшем" 
                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- Scan Button -->
        <Grid Grid.Row="1" Margin="0,20,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource SurfaceVariantBrush}"
                    CornerRadius="6"
                    Padding="12,8">
                <TextBlock Text="{Binding StatusText}"
                           VerticalAlignment="Center"/>
            </Border>

            <Button Grid.Column="1"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding ScanCommand}"
                    IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolConverter}}"
                    Margin="8,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Сканировать" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Discovered Apps List -->
        <Border Grid.Row="2" 
                Style="{StaticResource Card}">
            <Grid>
                <!-- Empty State -->
                <StackPanel VerticalAlignment="Center" 
                            HorizontalAlignment="Center"
                            Visibility="{Binding DiscoveredApps.Count, Converter={StaticResource CountToVisibilityConverter}}">
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" 
                               FontSize="48"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Нажмите «Сканировать» для поиска приложений" 
                               Style="{StaticResource BodyText}"
                               Margin="0,12,0,0"/>
                </StackPanel>

                <!-- List -->
                <ListView ItemsSource="{Binding DiscoveredApps}"
                          Background="Transparent"
                          BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0,8"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border Background="{TemplateBinding Background}" 
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceVariantBrush}"
                                    CornerRadius="8"
                                    Padding="16,12"
                                    Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Name and Path -->
                                    <StackPanel Grid.Column="0" Grid.Row="0">
                                        <TextBlock Text="{Binding Name}" 
                                                   FontWeight="SemiBold"
                                                   FontSize="14"/>
                                        <TextBlock Text="{Binding Path}" 
                                                   Style="{StaticResource Caption}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Path}"/>
                                    </StackPanel>

                                    <!-- Size -->
                                    <TextBlock Grid.Column="1" Grid.Row="0"
                                               Text="{Binding SizeFormatted}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               VerticalAlignment="Center"
                                               Margin="16,0"/>

                                    <!-- Add Button -->
                                    <Button Grid.Column="2" Grid.Row="0"
                                            Content="{Binding IsAdded, Converter={StaticResource BoolToAddedTextConverter}}"
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{Binding AddToKnowledgeBaseCommand}"
                                            IsEnabled="{Binding IsAdded, Converter={StaticResource InverseBoolConverter}}"
                                            VerticalAlignment="Center"/>

                                    <!-- Cache Folders -->
                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="3" 
                                                Orientation="Horizontal"
                                                Margin="0,8,0,0"
                                                Visibility="{Binding HasCacheSuggestions, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="Кэш:" 
                                                   Foreground="{DynamicResource SafeBrush}"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding CacheFoldersText}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>

                                    <!-- Protected Files -->
                                    <StackPanel Grid.Row="2" Grid.ColumnSpan="3" 
                                                Orientation="Horizontal"
                                                Margin="0,4,0,0"
                                                Visibility="{Binding HasProtectedSuggestions, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="Защищено:" 
                                                   Foreground="{DynamicResource CautionBrush}"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding ProtectedFilesText}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Button Content="Добавить все с кэшем"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding AddAllSafeCommand}"
                    HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</UserControl>
