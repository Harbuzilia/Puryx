<UserControl x:Class="SmartCleaner.App.Views.LargeFilesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AccentGradientBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Анализ больших файлов" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="HEAVY FILES" FontSize="9.5" Foreground="White" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Быстрый поиск и очистка самых тяжелых видео, архивов, виртуальных машин и дампов" 
                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" 
                CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Command="{Binding CancelScanCommand}"
                            Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Отмена" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ScanCommand}"
                            IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolConverter}}"
                            Style="{StaticResource PrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Найти" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Путь:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding ScanPath, UpdateSourceTrigger=PropertyChanged}" Width="280" Margin="0,0,4,0"/>
                    <Button Width="32"
                            Command="{Binding BrowseFolderCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,12,0" Padding="8,6">
                        <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                    </Button>

                    <TextBlock Text="Top:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Text="{Binding TopNText, UpdateSourceTrigger=PropertyChanged}" Width="40" Margin="0,0,12,0"/>

                    <TextBlock Text="Мин. МБ:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Text="{Binding MinSizeText, UpdateSourceTrigger=PropertyChanged}" Width="45"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Results -->
        <ListView Grid.Row="2" ItemsSource="{Binding Files}" 
                  Background="Transparent" BorderThickness="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" 
                            Padding="14,10" Margin="0,0,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- File info -->
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" 
                                               MaxWidth="500" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding SizeFormatted}" FontWeight="Bold" 
                                               Foreground="{DynamicResource CautionBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Directory}" FontSize="11" 
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Border Background="{DynamicResource SurfaceVariantBrush}" CornerRadius="3" 
                                            Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Extension}" FontSize="10"/>
                                    </Border>
                                    <TextBlock Text="{Binding Modified, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" 
                                               FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Actions -->
                            <Button Grid.Column="1"
                                    Command="{Binding DataContext.OpenInExplorerCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="8,6" Margin="8,0,4,0" ToolTip="Открыть в проводнике">
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                            </Button>
                            <Button Grid.Column="2"
                                    Command="{Binding DataContext.DeleteFileCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource DangerButton}"
                                    Padding="8,6" ToolTip="Удалить в корзину">
                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Status bar -->
        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" 
                CornerRadius="8" Padding="16,10" Margin="0,12,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}"
                           Visibility="{Binding TotalSizeFormatted, Converter={StaticResource NullToVisibilityConverter}}">
                    <Run Text="Итого: "/><Run Text="{Binding TotalSizeFormatted, Mode=OneWay}"/>
                </TextBlock>
                <StackPanel Orientation="Horizontal">
                    <ProgressBar Width="100" Height="4" IsIndeterminate="True" Margin="0,0,8,0"
                                 Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}"
                                 Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="{Binding StatusText}" 
                               Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
