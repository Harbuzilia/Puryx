<UserControl x:Class="SmartCleaner.App.Views.NetworkOptimizerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:SmartCleaner.Core.Localization;assembly=SmartCleaner.Core"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AccentGradientBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{x:Static loc:Localizer.NetworkOptimizer_Title}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="LOW LATENCY" FontSize="9.5" Foreground="White" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="{x:Static loc:Localizer.NetworkOptimizer_Subtitle}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Quick Action Cards -->
            <UniformGrid Grid.Row="0" Columns="2" Margin="0,0,0,16">
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="20" Margin="0,0,8,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{x:Static loc:Localizer.NetworkOptimizer_ResetTitle}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{x:Static loc:Localizer.NetworkOptimizer_ResetDescription}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,14"/>

                        <Button Command="{Binding FlushDnsAndWinsockCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Static loc:Localizer.NetworkOptimizer_FlushAction}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="20" Margin="8,0,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{x:Static loc:Localizer.NetworkOptimizer_NoDelayTitle}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{x:Static loc:Localizer.NetworkOptimizer_NoDelayDescription}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,14"/>

                        <CheckBox Content="{x:Static loc:Localizer.NetworkOptimizer_EnableNoDelay}" 
                                  IsChecked="{Binding IsTcpNoDelayEnabled, Mode=TwoWay}"
                                  Command="{Binding ToggleTcpNoDelayCommand}"
                                  FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- DNS Switcher Table -->
            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock DockPanel.Dock="Left" Text="{x:Static loc:Localizer.NetworkOptimizer_DnsTableTitle}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="{x:Static loc:Localizer.NetworkOptimizer_BenchmarkPing}" 
                                    Command="{Binding BenchmarkDnsCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="14,6"/>

                            <Button Content="{x:Static loc:Localizer.NetworkOptimizer_ResetToDhcp}" 
                                    Command="{Binding ResetToDhcpCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                    Style="{StaticResource SecondaryButton}" Padding="14,6"/>
                        </StackPanel>
                    </DockPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Presets}" AutoGenerateColumns="False" CanUserAddRows="False" Background="Transparent" BorderThickness="0" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Name}" Header="{x:Static loc:Localizer.NetworkOptimizer_ColProvider}" Width="280" FontWeight="SemiBold"/>
                            <DataGridTextColumn Binding="{Binding Primary}" Header="{x:Static loc:Localizer.NetworkOptimizer_ColPrimary}" Width="140"/>
                            <DataGridTextColumn Binding="{Binding Secondary}" Header="{x:Static loc:Localizer.NetworkOptimizer_ColSecondary}" Width="150"/>
                            <DataGridTextColumn Binding="{Binding LatencyFormatted}" Header="{x:Static loc:Localizer.NetworkOptimizer_ColLatency}" Width="130" Foreground="{DynamicResource SafeBrush}"/>
                            
                            <DataGridTemplateColumn Header="{x:Static loc:Localizer.NetworkOptimizer_ColAction}" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{x:Static loc:Localizer.NetworkOptimizer_Apply}" 
                                                Command="{Binding DataContext.ApplyDnsPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource PrimaryButton}" Padding="12,4" Height="26" FontSize="11"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="14,10" Margin="0,12,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Right" Width="120" Height="6" IsIndeterminate="{Binding IsBusy}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
