<UserControl x:Class="SmartCleaner.App.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SmartCleaner.App.Controls">

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AccentGradientBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Аналитический дашборд" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ANALYTICS" FontSize="9.5" Foreground="White" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Хроника освобожденного дискового пространства, история сессий и диаграмма категорий" 
                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Обновить" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ClearHistoryCommand}" Style="{StaticResource DangerButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Очистить историю" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- Summary Cards -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" CornerRadius="8" Background="{DynamicResource AccentBadgeBrush}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TotalSessions}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="СЕССИЙ ОЧИСТКИ" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Margin="4,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" CornerRadius="8" Background="{DynamicResource SafeBadgeBrush}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource SafeBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TotalFreed}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource SafeBrush}"/>
                        <TextBlock Text="ОСВОБОЖДЕНО ВСЕГО" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Margin="4,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" CornerRadius="8" Background="{DynamicResource AccentBadgeBrush}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TotalFiles}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="ФАЙЛОВ УДАЛЕНО" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" CornerRadius="8" Background="{DynamicResource CautionBadgeBrush}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="&#xE7E3;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource CautionBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AveragePerSession}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource CautionBrush}"/>
                        <TextBlock Text="СРЕДНЕЕ ЗА СЕССИЮ" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- Charts -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Chart mode selector -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Период:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                <ComboBox SelectedIndex="{Binding ChartModeIndex}" Width="150">
                    <ComboBoxItem Content="По месяцам"/>
                    <ComboBoxItem Content="По неделям"/>
                </ComboBox>
            </StackPanel>

            <!-- Monthly chart -->
            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="16,12"
                    Visibility="{Binding ChartModeIndex, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=0}">
                <StackPanel>
                    <TextBlock Text="Освобождено по месяцам" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <controls:BarChartControl 
                        Values="{Binding MonthlyValues}" 
                        Labels="{Binding MonthlyLabels}"
                        Height="300"
                        Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Weekly chart -->
            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="16,12"
                    Visibility="{Binding ChartModeIndex, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=1}">
                <StackPanel>
                    <TextBlock Text="Освобождено по неделям" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <controls:BarChartControl 
                        Values="{Binding WeeklyValues}" 
                        Labels="{Binding WeeklyLabels}"
                        BarColor="LimeGreen"
                        Height="300"
                        Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
