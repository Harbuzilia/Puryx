<Window x:Class="SmartCleaner.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:SmartCleaner.App.Helpers"
        Title="О программе — Puryx" 
        Height="360" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable, Segoe UI">
    
    <Grid Margin="24,20">
        <Border Style="{StaticResource Card}" Padding="28,24" VerticalAlignment="Center">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- Icon with radiant gradient container -->
                <Border Width="60" Height="60" CornerRadius="14" Background="{DynamicResource AccentGradientBrush}"
                        HorizontalAlignment="Center" Margin="0,0,0,12">
                    <TextBlock Text="&#xE74D;" 
                               FontFamily="Segoe MDL2 Assets" 
                               FontSize="30"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                
                <!-- Title & Badge -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Puryx"
                               FontSize="20" 
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{x:Static helpers:AppInfo.VersionBadge}" FontSize="9.5" FontWeight="Bold" Foreground="White"/>
                    </Border>
                </StackPanel>
                
                <!-- Subtitle -->
                <TextBlock Text="Puryx — Ультимативный комплекс очистки и тюнинга Windows" 
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,4,0,0"/>
                
                <!-- Tech Spec Card -->
                <Border Background="{DynamicResource SurfaceVariantBrush}" CornerRadius="6" Padding="12,8" Margin="0,16,0,0">
                    <TextBlock Text=".NET 8.0 LTS · WPF MVVM · 16 сканеров · Anti-Spy · Services Optimizer · Game Boost · CompactOS" 
                               FontSize="11"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Copyright -->
                <TextBlock Text="© 2026 Puryx Team. Высокая производительность и полная безопасность." 
                           FontSize="10.5"
                           Foreground="{DynamicResource TextDisabledBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0"/>

                <!-- Close Button -->
                <Button Content="Закрыть" 
                        HorizontalAlignment="Center"
                        Margin="0,18,0,0"
                        Padding="28,7"
                        Click="Close_Click"
                        Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
