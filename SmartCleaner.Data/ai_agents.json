{
  "version": "1.0",
  "apps": {
    "Antigravity": {
      "displayName": "Antigravity (Google)",
      "rootPaths": [
        "%USERPROFILE%\\.gemini"
      ],
      "cachePatterns": [],
      "protectedPatterns": [
        "**/*"
      ],
      "workspaceMarkers": [".agent"],
      "description": "Все данные Antigravity критичны — brain, rules, workflows. НЕ УДАЛЯТЬ!"
    },
    "Cursor": {
      "displayName": "Cursor AI",
      "rootPaths": [
        "%APPDATA%\\Cursor",
        "%LOCALAPPDATA%\\Programs\\cursor",
        "%USERPROFILE%\\.cursor"
      ],
      "cachePatterns": [
        "Cache",
        "CachedData",
        "Code Cache",
        "GPUCache",
        "logs"
      ],
      "protectedPatterns": [
        "User/globalStorage",
        "User/workspaceStorage",
        "User/settings.json",
        "*.sqlite*"
      ],
      "workspaceMarkers": []
    },
    "Kiro": {
      "displayName": "Kiro (Amazon AWS)",
      "rootPaths": [
        "%LOCALAPPDATA%\\Programs\\Kiro",
        "%USERPROFILE%\\.kiro"
      ],
      "cachePatterns": [
        "Cache",
        "logs"
      ],
      "protectedPatterns": [
        "settings",
        "*.json"
      ],
      "workspaceMarkers": [".kiro"]
    },
    "Windsurf": {
      "displayName": "Windsurf (Codeium)",
      "rootPaths": [
        "%USERPROFILE%\\.codeium"
      ],
      "cachePatterns": [
        "cache"
      ],
      "protectedPatterns": [
        "windsurf/cascade"
      ],
      "description": "cascade содержит историю чатов — НЕ УДАЛЯТЬ!"
    },
    "ClaudeDesktop": {
      "displayName": "Claude Desktop",
      "rootPaths": [
        "%APPDATA%\\Claude"
      ],
      "cachePatterns": [
        "logs"
      ],
      "protectedPatterns": [
        "claude_desktop_config.json",
        "*.db",
        "*.sqlite*"
      ]
    },
    "VSCode": {
      "displayName": "Visual Studio Code",
      "rootPaths": [
        "%APPDATA%\\Code",
        "%USERPROFILE%\\.vscode"
      ],
      "cachePatterns": [
        "Cache",
        "CachedData",
        "CachedExtensions",
        "CachedExtensionVSIXs",
        "Code Cache",
        "GPUCache",
        "logs"
      ],
      "protectedPatterns": [
        "User/globalStorage",
        "User/workspaceStorage",
        "User/settings.json",
        "User/keybindings.json",
        "extensions"
      ],
      "workspaceMarkers": [".vscode"]
    },
    "JetBrains": {
      "displayName": "JetBrains IDEs",
      "rootPaths": [
        "%LOCALAPPDATA%\\JetBrains"
      ],
      "cachePatterns": [
        "*/caches",
        "*/index",
        "*/log"
      ],
      "protectedPatterns": [
        "*/config",
        "*/options",
        "*/keymaps"
      ],
      "workspaceMarkers": [".idea"]
    }
  }
}
