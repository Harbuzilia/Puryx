{
    "version": "1.0",
    "paths": {
        "WindowsTemp": {
            "displayName": "Временные файлы Windows",
            "path": "%TEMP%",
            "patterns": [
                "*.tmp",
                "*.log",
                "*.bak",
                "*.old",
                "~*"
            ],
            "excludePatterns": [],
            "risk": "SafeToDelete",
            "requiresElevation": false
        },
        "SystemTemp": {
            "displayName": "Системные временные файлы",
            "path": "%WINDIR%\\Temp",
            "patterns": [
                "*"
            ],
            "excludePatterns": [],
            "risk": "SafeToDelete",
            "requiresElevation": true
        },
        "Prefetch": {
            "displayName": "Prefetch (ускорение запуска)",
            "path": "%WINDIR%\\Prefetch",
            "patterns": [
                "*.pf"
            ],
            "excludePatterns": [],
            "risk": "PerformanceCache",
            "requiresElevation": true,
            "description": "Ускоряет запуск программ. После очистки первый запуск будет медленнее."
        },
        "WindowsUpdateCleanup": {
            "displayName": "Файлы обновления Windows",
            "path": "%WINDIR%\\SoftwareDistribution\\Download",
            "patterns": [
                "*"
            ],
            "excludePatterns": [],
            "risk": "SafeToDelete",
            "requiresElevation": true
        },
        "ThumbnailCache": {
            "displayName": "Кэш миниатюр",
            "path": "%LOCALAPPDATA%\\Microsoft\\Windows\\Explorer",
            "patterns": [
                "thumbcache_*.db",
                "iconcache_*.db"
            ],
            "excludePatterns": [],
            "risk": "SafeToDelete",
            "requiresElevation": false
        },
        "RecentDocs": {
            "displayName": "Недавние документы",
            "path": "%APPDATA%\\Microsoft\\Windows\\Recent",
            "patterns": [
                "*.lnk"
            ],
            "excludePatterns": [],
            "risk": "SafeToDelete",
            "requiresElevation": false
        },
        "CrashDumps": {
            "displayName": "Дампы аварий",
            "path": "%LOCALAPPDATA%\\CrashDumps",
            "patterns": [
                "*.dmp"
            ],
            "excludePatterns": [],
            "risk": "SafeToDelete",
            "requiresElevation": false
        },
        "WindowsErrorReports": {
            "displayName": "Отчёты об ошибках Windows",
            "path": "%LOCALAPPDATA%\\Microsoft\\Windows\\WER",
            "patterns": [
                "*"
            ],
            "excludePatterns": [],
            "risk": "SafeToDelete",
            "requiresElevation": false
        },
        "DeliveryOptimization": {
            "displayName": "Кэш оптимизации доставки",
            "path": "%WINDIR%\\SoftwareDistribution\\DeliveryOptimization",
            "patterns": [
                "*"
            ],
            "excludePatterns": [],
            "risk": "SafeToDelete",
            "requiresElevation": true
        }
    }
}