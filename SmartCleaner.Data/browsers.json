            "cachePatterns": [
                "Default/Cache",
                "Default/Code Cache",
                "Default/GPUCache",
                "Default/Service Worker/CacheStorage",
                "Default/Service Worker/ScriptCache",
                "ShaderCache",
                "GrShaderCache"
